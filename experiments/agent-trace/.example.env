# OpenAI-compatible endpoint. Use the API base URL, usually ending in /v1.
# Examples:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://localhost:8000/v1
LLM_BASE_URL=https://api.moeco.fun/v1

# Optional for local providers that do not require authentication.
LLM_API_KEY=

# Model name understood by your provider.
LLM_MODEL=gpt-5.6-luna

# Keep temperature at 0 for reproducible evaluation experiments.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=12800
LLM_TIMEOUT_SECONDS=60

# Agent controls.
AGENT_MAX_TURNS=8
AGENT_DEBUG=true

# -----------------------------
# Langfuse / OpenTelemetry
# -----------------------------
# Set false to run the exact same agent without tracing.
LANGFUSE_ENABLED=true

# EU Cloud:
#   https://cloud.langfuse.com
# US Cloud:
#   https://us.cloud.langfuse.com
# Japan Cloud:
#   https://jp.cloud.langfuse.com
# Self-hosted example:
#   http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"

# Optional: override the complete OTLP/HTTP traces endpoint.
# If empty, the application derives:
#   ${LANGFUSE_BASE_URL}/api/public/otel/v1/traces
LANGFUSE_OTLP_TRACES_ENDPOINT=

LANGFUSE_ENVIRONMENT=development
LANGFUSE_TRACE_NAME=agent-chat

# Capture prompts, tool arguments/results, and final answers in Langfuse.
# Disable this when tracing sensitive content.
LANGFUSE_CAPTURE_CONTENT=true

# OTEL resource attributes.
OTEL_SERVICE_NAME=go-agent-eval
OTEL_SERVICE_VERSION=phase-3

# -----------------------------
# Phase 3 evaluation
# -----------------------------
EVAL_DATASET_PATH=experiments/agent-trace/evaldata/cases.jsonl
EVAL_DATASET_NAME=go-agent-eval-phase3
EVAL_UPLOAD_DATASET=true
EVAL_REPORT_PATH=experiments/agent-trace/eval-results/latest.json
EVAL_RUN_NAME=baseline-v1
EVAL_TRACE_NAME=agent-eval
EVAL_ENVIRONMENT=experiment

# Upload deterministic metrics to Langfuse trace-level scores.
EVAL_UPLOAD_SCORES=true